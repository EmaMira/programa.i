#include <stdio.h>

int main() {
    int altura, opcao;

    printf("Digite a altura do triangulo: ");
    scanf("%d", &altura);

    printf("Escolha o tipo (1 - Preenchido, 2 - Vazado): ");
    scanf("%d", &opcao);

    for (int i = 0; i < altura; i++) {
        for (int j = 0; j <= i; j++) {
            if (opcao == 1 || j == 0 || j == i || i == altura - 1) {
                printf("*");
            } else {
                printf(" ");
            }
        }
        printf("\n");
    }

    return 0;
}
